{
  "name": "chisa-terminal",
  "version": "1.0.0",
  "description": "ChisaTerminal - 一个现代化的终端模拟器",
  "main": "dist/main/main/index.js",
  "type": "module",
  "scripts": {
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.main.json -w",
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:main\" \"wait-on http://localhost:5173 && electron .\"",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "powershell -Command \"if (Test-Path dist/main/preload) { Remove-Item -Recurse -Force dist/main/preload }\" && tsc -p tsconfig.preload.json && echo {\"type\":\"commonjs\"} > dist/main/preload/package.json",
    "build": "npm run build:renderer && npm run build:main && npm run build:preload",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:win:en": "node -e \"const fs=require('fs');const p='c:/Ai/mux0_link';try{fs.symlinkSync(process.cwd(),p,'junction')}catch(e){};process.chdir(p);require('child_process').execSync('npm run dist:win',{stdio:'inherit',cwd:p})\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project=unit",
    "test:integration": "vitest run --project=integration --passWithNoTests",
    "test:e2e": "tsx test/e2e/run-e2e.ts",
    "test:ai-smoke": "tsx test/e2e/run-ai-smoke.ts",
    "test:sshd-up": "docker compose -f test/fixtures/docker-compose-sshd.yml up -d"
  },
  "keywords": [
    "terminal",
    "electron",
    "ai-agent"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.1",
    "canvas": "^3.2.3",
    "concurrently": "^9.1.2",
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.9",
    "wait-on": "^8.0.3"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "electron-store": "^10.0.0",
    "i18next": "^26.3.3",
    "node-pty": "^1.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.8",
    "zustand": "^5.0.14"
  }
}
